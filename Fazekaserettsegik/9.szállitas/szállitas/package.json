{
  "name": "ts-console-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript starter",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "dev-tsx": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc",
    "start:js": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
